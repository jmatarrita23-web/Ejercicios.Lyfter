import unittest
from unittest.mock import patch
from io import StringIO

# ---------- EJERCICIO 3 ----------

def sum_of_list(numbers):
    return sum(numbers)


# ---------- EJERCICIO 4 ----------

def flip(text):
    reversed_text = ""

    for i in range(len(text) - 1, -1, -1):
        reversed_text += text[i]

    return reversed_text


# ---------- EJERCICIO 5 ----------

def lower_cap_letters():
    text = input("Ingrese un texto: ")
    Cap_letters = 0
    Lower_letters = 0

    for letter in text:
        if letter.isupper():
            Cap_letters += 1
        elif letter.islower():
            Lower_letters += 1

    print(f"El número de letras mayúsculas es: {Cap_letters}")
    print(f"El número de letras minúsculas es: {Lower_letters}")


# ---------- EJERCICIO 6 ----------

def phrase_order(phrase):
    list_phrase = phrase.split("-")
    sort_phrase = sorted(list_phrase)
    print("-".join(sort_phrase))


# ---------- EJERCICIO 7 ----------

def only_prime_numbers(numbers):
    primes = []

    for num in numbers:
        if num <= 1:
            continue

        is_prime = True

        for i in range(2, num):
            if num % i == 0:
                is_prime = False
                break

        if is_prime:
            primes.append(num)

    return primes


